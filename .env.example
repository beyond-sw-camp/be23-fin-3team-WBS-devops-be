# Spring profile
SPRING_PROFILES_ACTIVE=prod

# Service ports
API_GATEWAY_SERVER_PORT=8080
ACCOUNT_SERVER_PORT=8080
MASTER_SERVER_PORT=8080
STOCK_SERVER_PORT=8080
SEARCH_SERVER_PORT=8080

# Gateway
GATEWAY_ALLOWED_ORIGINS=https://your-frontend.example.com
GATEWAY_CONNECT_TIMEOUT_MS=3000
GATEWAY_RESPONSE_TIMEOUT=10s
ACCOUNT_SERVICE_URI=http://account-service
MASTER_SERVICE_URI=http://master-service
STOCK_SERVICE_URI=http://stock-service
SEARCH_SERVICE_URI=http://search-service

# Internal service-to-service calls
ACCOUNT_SERVICE_URL=http://account-service
MASTER_SERVICE_URL=http://master-service
STOCK_SERVICE_URL=http://stock-service

# MySQL databases
ACCOUNT_DB_URL=jdbc:mysql://database-1.cliqi2umyj97.ap-northeast-2.rds.amazonaws.com:3306/account_db?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
ACCOUNT_DB_USERNAME=wbs_account
ACCOUNT_DB_PASSWORD=change-me

MASTER_DB_URL=jdbc:mysql://database-1.cliqi2umyj97.ap-northeast-2.rds.amazonaws.com:3306/master_db?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
MASTER_DB_USERNAME=wbs_master
MASTER_DB_PASSWORD=change-me

STOCK_DB_URL=jdbc:mysql://database-1.cliqi2umyj97.ap-northeast-2.rds.amazonaws.com:3306/stock_db?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
STOCK_DB_USERNAME=wbs_stock
STOCK_DB_PASSWORD=change-me

# Redis / Kafka / Elasticsearch
REDIS_HOST=redis
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SPRING_ELASTICSEARCH_URIS=http://elasticsearch:9200

# Kafka consumer groups and streams
SEARCH_KAFKA_GROUP_ID=search-group
STOCK_KAFKA_GROUP_ID=stock-group
STOCK_STREAMS_APPLICATION_ID=stock-streams
STOCK_KAFKA_STREAMS_STATE_DIR=/tmp/kafka-streams/stock
KAFKA_REPLICATION_FACTOR=1

# JWT
JWT_EXPIRATION_MINUTES=30
JWT_SECRET_KEY=base64-encoded-access-token-secret
JWT_REFRESH_EXPIRATION_MINUTES=30000
JWT_REFRESH_SECRET_KEY=base64-encoded-refresh-token-secret

# AWS / S3
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
AWS_REGION=ap-northeast-2
AWS_S3_PROFILE_BUCKET=wbs-profile-bucket
AWS_S3_INSTRUCTION_BUCKET=wbs-instruction-docs
AWS_S3_INSTRUCTION_PRESIGN_TTL_SECONDS=300
AWS_S3_DEFECT_EVIDENCE_BUCKET=wbs-instruction-docs
AWS_S3_DEFECT_EVIDENCE_DOWNLOAD_TTL_SECONDS=300

# Stock mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-smtp-account@example.com
MAIL_PASSWORD=change-me
MAIL_DEBUG=false
INBOUND_REQUEST_MAIL_TO=oms-team@example.com
INBOUND_REQUEST_MAIL_FROM=your-smtp-account@example.com
INBOUND_REQUEST_MAIL_FROM_NAME=WMS 시스템
INBOUND_REQUEST_MAIL_SUBJECT_PREFIX=[기타출고] 입고 요청

# Stock upload / instruction document
DEFECT_EVIDENCE_MAX_FILE_SIZE_BYTES=5242880
DEFECT_EVIDENCE_MAX_PER_SOURCE=5
DEFECT_EVIDENCE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/heic,image/heif
MULTIPART_MAX_FILE_SIZE=6MB
MULTIPART_MAX_REQUEST_SIZE=6MB
INSTRUCTION_DOCUMENT_TOPIC=instruction.issued
INSTRUCTION_DOCUMENT_CONSUMER_GROUP=instruction-doc-group
INSTRUCTION_DOCUMENT_DLQ_TOPIC=instruction.issued.dlq
INSTRUCTION_DOCUMENT_RETRY_MAX_ATTEMPTS=3
INSTRUCTION_DOCUMENT_RETRY_INITIAL_INTERVAL_MS=500
INSTRUCTION_DOCUMENT_RETRY_MULTIPLIER=2.0

# Logging
LOGGING_LEVEL_WBS=INFO
